# Copia este archivo como .env en la raíz del proyecto (NO se sube al repo)
# y rellena los valores que necesites.

# Canal público que lee `scrape` (por defecto, el actual)
TELEGRAM_CANAL=DistribuidoraMonikVariety04

# Categoría por defecto solo si usas `apply -y` y no hay sugerencia automática
CATEGORIA_DEFAULT=hogar

# SOLO para el modo bot (`run`) — opcional:
# token de @BotFather y id del chat donde está el bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
